  "schemas": {
    "BlockEdit": {
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Id"
        },
        "kind": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "assessment",
                "personal"
              ]
            },
            {
              "type": "null"
            }
          ],
