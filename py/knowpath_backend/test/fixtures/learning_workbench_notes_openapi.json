          "type": "string",
          "maxLength": 200000,
          "title": "Markdown"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "markdown"
      ],
      "title": "CorrectionEdit"
    },
    "ChapterEdit": {
      "properties": {
        "expected_version": {
          "type": "integer",
          "minimum": 1.0,
          "title": "Expected Version"
        },
        "blocks": {
          "items": {
            "$ref": "#/components/schemas/BlockEdit"
          },
          "type": "array",
          "maxItems": 1000,
          "title": "Blocks"
        },
        "corrections": {
          "items": {
            "$ref": "#/components/schemas/CorrectionEdit"
          },
          "type": "array",
          "maxItems": 1000,
          "title": "Corrections"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "expected_version"
      ],
      "title": "ChapterEdit"
    },
    "RetryRequest": {
      "properties": {},
      "additionalProperties": false,
      "type": "object",
      "title": "RetryRequest"
    }
  },
