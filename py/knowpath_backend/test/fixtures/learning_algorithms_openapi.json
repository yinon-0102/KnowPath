  "schemas": {
    "ComparePlans": {
      "properties": {
        "budgets_minutes_per_day": {
          "items": {
            "type": "integer",
            "maximum": 480.0,
            "minimum": 1.0
          },
          "type": "array",
          "maxItems": 5,
          "minItems": 2,
          "title": "Budgets Minutes Per Day"
        },
        "horizon_days": {
          "type": "integer",
          "maximum": 30.0,
          "minimum": 1.0,
          "title": "Horizon Days",
          "default": 7
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "budgets_minutes_per_day"
      ],
      "title": "ComparePlans"
    },
    "ReplayRequest": {
      "properties": {
        "limit": {
          "type": "integer",
          "maximum": 1000.0,
          "minimum": 1.0,
          "title": "Limit",
          "default": 200
        },
        "minimum_delay_hours": {
          "type": "integer",
          "maximum": 8760.0,
          "minimum": 24.0,
          "title": "Minimum Delay Hours",
          "default": 24
        },
        "from_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "From Time"
        },
        "to_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "To Time"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "ReplayRequest"
    }
