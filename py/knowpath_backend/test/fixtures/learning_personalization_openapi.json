  "schemas": {
    "Activity": {
      "properties": {
        "event": {
          "type": "string",
          "enum": [
            "heartbeat",
            "pause",
            "resume",
            "hidden",
            "visible",
            "disconnect",
            "reconnect",
            "waiting",
            "ready"
          ],
          "title": "Event",
          "default": "heartbeat"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "Activity"
    },
    "AnswerActivity": {
      "properties": {
        "question_id": {
          "type": "string",
          "minLength": 1,
          "title": "Question Id"
        },
        "event": {
          "type": "string",
          "enum": [
            "shown",
            "heartbeat",
            "pause",
            "resume",
            "hidden",
            "visible",
            "disconnect",
            "reconnect",
            "waiting",
            "ready"
          ],
          "title": "Event",
          "default": "heartbeat"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "question_id"
      ],
      "title": "AnswerActivity"
    },
    "ApplyRecommendation": {
      "properties": {
        "expected_plan_version": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1.0
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected Plan Version"
        },
        "preview": {
          "type": "boolean",
          "title": "Preview",
          "default": true
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "ApplyRecommendation"
    },
    "CreateLesson": {
      "properties": {
        "plan_id": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "title": "Plan Id"
        },
        "task_id": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "title": "Task Id"
        },
        "style": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "plain",
                "examples_first",
                "concise",
                "deep"
              ]
            },
            {
              "type": "null"
            }
          ],
          "title": "Style"
        },
        "instructions": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ],
          "title": "Instructions"
        },
        "learning_session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Learning Session Id"
        },
        "regenerate": {
          "type": "boolean",
          "title": "Regenerate",
          "default": false
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "plan_id",
        "task_id"
      ],
      "title": "CreateLesson"
    },
    "OrderPlan": {
      "properties": {
        "expected_plan_version": {
          "type": "integer",
          "minimum": 1.0,
          "title": "Expected Plan Version"
        },
        "order_mode": {
          "type": "string",
          "enum": [
            "source",
            "adaptive",
            "custom"
          ],
          "title": "Order Mode"
        },
        "material_order": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Material Order"
        },
        "ordered_node_ids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ordered Node Ids"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "expected_plan_version",
        "order_mode"
      ],
      "title": "OrderPlan"
    },
    "ReadingContext": {
      "properties": {
        "material_id": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "title": "Material Id"
        },
        "material_version_id": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "title": "Material Version Id"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
