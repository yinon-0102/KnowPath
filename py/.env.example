# .env file
LLM_API_KEY=
LLM_MODEL_ID="MiniMax-M2.7"
LLM_BASE_URL="https://api.minimaxi.com/v1"
SERPAPI_API_KEY=

# Keel Learning
LEARNING_PERSISTENCE=memory
DASHSCOPE_API_KEY=
DATABASE_URL=mysql+pymysql://keel:keel@127.0.0.1:3306/keel_learning
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=keel_learning
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=keel_material_chunks
QDRANT_API_KEY=
# graph_worker_cli prepares version-scoped vectors before publication; vector_indexing is also available for rebuilds.
LEARNING_RETRIEVAL_BACKEND=keyword
LEARNING_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LEARNING_EMBEDDING_PROVIDER=dashscope
LEARNING_EMBEDDING_MODEL=text-embedding-v3
LEARNING_EMBEDDING_DIMENSION=1024
LEARNING_LOCAL_TOKEN=

# Production ASGI and both workers load py/.env; choose sql for durable operation.
# LEARNING_CONFIG_FILE=learning-config.local.json
LEARNING_CHAT_PROVIDER=dashscope
LEARNING_CHAT_MODEL=qwen-plus
LEARNING_CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LEARNING_CHAT_API_KEY_ENV=DASHSCOPE_API_KEY
LEARNING_CHAT_TIMEOUT_SECONDS=60
LEARNING_EMBEDDING_API_KEY_ENV=DASHSCOPE_API_KEY
# Empty token => create and reuse py/.learning-token.local (never commit it).
# LEARNING_LOCAL_TOKEN_FILE=.learning-token.local
LEARNING_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
