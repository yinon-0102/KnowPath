              "block": "16c25d9394386024716a7b44edd83b42ca56e836055a54dfef63a9613bb7705e"
            }
          ]
        },
        "heading": {
          "source_text": "第一章 总则\n",
          "section_path": [
            "第一章 总则"
          ],
          "source_spans": [
            {
              "material_version_id": "1984750c417fbc6e8e3b108d964ab38844418019bc54bee2d19e9cac84356842",
              "artifact_hash": "22c3f9ecabc299d88d0683d1a6d306df77b5fa83db3e549e0d1754d4a92b65cd",
              "start": 327,
              "end": 334,
              "page": 1,
              "block": "16c25d9394386024716a7b44edd83b42ca56e836055a54dfef63a9613bb7705e"
            }
          ]
        },
        "article": {
          "source_text": "第一条 为了保护未成年人身心健康，保障未成年人合法\n权益，促进未成年人德智体美劳全面发展，培养有理想、有道\n德、有文化、有纪律的社会主义建设者和接班人，培养担当民\n族复兴大任的时代新人，根据宪法，制定本法。\n",
          "section_path": [
            "第一章 总则"
          ],
          "source_spans": [
            {
              "material_version_id": "1984750c417fbc6e8e3b108d964ab38844418019bc54bee2d19e9cac84356842",
